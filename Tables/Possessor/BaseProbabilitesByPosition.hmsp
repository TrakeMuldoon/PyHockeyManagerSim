# N = Do Nothing
# PB = Pass Back, PL = Pass Lateral, PF = Pass Forward
# CB = Carry Back, CL = Carry Lateral, CF = Carry Forward
# SS = Shoot Soft (shoot low, break out), SH = Shoot Hard (shoot high, ice it)
